{
  "functions": {
    "src/app/api/cron/**/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/poll-whitehouse",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/poll-defense",
      "schedule": "5 22 * * 1-5"
    },
    {
      "path": "/api/cron/update-forward-returns",
      "schedule": "30 9 * * *"
    }
  ]
}
