# Supabase (create project at supabase.com, run migration from supabase/migrations/)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: AI classification (gated by prefilter)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ENABLE_AI_CLASSIFIER=false

# Market data (stub used if unset)
FINNHUB_API_KEY=

# Alerts (live events only when enabled)
DISCORD_WEBHOOK_URL=
ENABLE_DISCORD_ALERTS=false

# Source polling cron
ENABLE_SOURCE_POLLING=false
CRON_SECRET=change-me-in-production

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development
